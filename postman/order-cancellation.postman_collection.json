{
  "info": {
    "_postman_id": "c1f7a28e-8e4a-43cf-bf22-c3a50d4b971a",
    "name": "E-Commerce - Cancelamento de Pedidos (DELETE /order/{id})",
    "description": "Suíte de testes Postman para validar o novo endpoint RESTful DELETE /order/{id}, cobrindo todos os cenários obrigatórios: cancelamento com estorno, pedido inexistente, sem autenticação, sem permissão, idempotência, bloqueio pós-envio e desativação do endpoint anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticação & Setup",
      "item": [
        {
          "name": "01.1 - Login Cliente Titular",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.tokens) {",
                  "    pm.environment.set(\"userToken\", json.data.tokens.accessToken);",
                  "    pm.environment.set(\"userId\", json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "01.2 - Login Outro Cliente (Sem Permissão)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.tokens) {",
                  "    pm.environment.set(\"otherUserToken\", json.data.tokens.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"outro@teste.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "01.3 - Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.tokens) {",
                  "    pm.environment.set(\"adminToken\", json.data.tokens.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "01.4 - Buscar Produto e Gravar Estoque Inicial",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var items = json.data && json.data.content ? json.data.content : json.data;",
                  "pm.expect(items.length).to.be.above(0);",
                  "var p = items[0];",
                  "pm.environment.set(\"productId\", p.id);",
                  "pm.environment.set(\"initialStock\", p.stock);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Cenário 1: Cancelamento de Pedido Existente (DELETE /order/{id})",
      "item": [
        {
          "name": "02.1 - Adicionar Produto ao Carrinho",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Item adicionado ao carrinho com sucesso (200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "02.2 - Checkout Criando Pedido PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Pedido criado com sucesso (201)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.expect(json.data.status).to.eql(\"PENDING\");",
                  "pm.environment.set(\"orderId\", json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order",
              "host": ["{{baseUrl}}"],
              "path": ["order"]
            }
          }
        },
        {
          "name": "02.3 - Verificar Débito Imediato no Estoque",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estoque foi decrementado após checkout\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    var initial = parseInt(pm.environment.get(\"initialStock\"));",
                  "    pm.expect(json.data.stock).to.eql(initial - 2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "02.4 - Cancelamento do Pedido com DELETE /order/{id}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200 OK ao cancelar via DELETE /order/{id}\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Status do pedido atualizado para CANCELED\", function () {",
                  "    pm.expect(json.data.status).to.eql(\"CANCELED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["order", "{{orderId}}"]
            }
          }
        },
        {
          "name": "02.5 - Verificar Recomposição Exata do Estoque",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estoque integralmente restaurado para o saldo inicial\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    var initial = parseInt(pm.environment.get(\"initialStock\"));",
                  "    pm.expect(json.data.stock).to.eql(initial);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Cenário 2: Cancelamento de Pedido Inexistente (404)",
      "item": [
        {
          "name": "03.1 - Tentativa de Cancelamento de Pedido Inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Retorna 404 Not Found para pedido inexistente\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Mensagem explicativa de não encontrado\", function () {",
                  "    pm.expect(json.error.message).to.eql(\"Pedido não encontrado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/pedido-inexistente-uuid-9999",
              "host": ["{{baseUrl}}"],
              "path": ["order", "pedido-inexistente-uuid-9999"]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Cenário 3: Cancelamento sem Autenticação (401)",
      "item": [
        {
          "name": "04.1 - Cancelamento sem Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Retorna 401 Unauthorized sem cabeçalho Authorization\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["order", "{{orderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Cenário 4: Cancelamento com Usuário sem Permissão (403)",
      "item": [
        {
          "name": "05.1 - Cancelamento por Terceiro sem Role ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Retorna 403 Forbidden para usuário não titular\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Mensagem de acesso negado\", function () {",
                  "    pm.expect(json.error.message).to.eql(\"Acesso negado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherUserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["order", "{{orderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Cenário 5: Tentativa de Cancelar Pedido Já Cancelado (Idempotência)",
      "item": [
        {
          "name": "06.1 - Cancelar Pedido Novamente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Retorna 200 OK com status CANCELED de forma idempotente\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.expect(json.data.status).to.eql(\"CANCELED\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["order", "{{orderId}}"]
            }
          }
        },
        {
          "name": "06.2 - Confirmar Não Duplicação do Estoque",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estoque permanece inalterado sem dupla recomposição\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    var initial = parseInt(pm.environment.get(\"initialStock\"));",
                  "    pm.expect(json.data.stock).to.eql(initial);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Cenário 6: Pedido em Estado Que Não Permite Cancelamento (400)",
      "item": [
        {
          "name": "07.1 - Cancelar Pedido com Status SHIPPED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Retorna 400 Bad Request para pedido já enviado\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Mensagem explicativa sobre envio/entrega\", function () {",
                  "    pm.expect(json.error.message.toLowerCase()).to.include(\"enviados\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/ord-shipped-01",
              "host": ["{{baseUrl}}"],
              "path": ["order", "ord-shipped-01"]
            }
          }
        }
      ]
    },
    {
      "name": "08 - Validação: Endpoint Anterior Desativado (404)",
      "item": [
        {
          "name": "08.1 - Chamar Antigo POST /order/{id}/cancel",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Endpoint anterior /cancel não deve mais existir (404 Not Found)\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["order", "{{orderId}}", "cancel"]
            }
          }
        }
      ]
    }
  ]
}
